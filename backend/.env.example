# Copie este arquivo para .env e ajuste os valores. O .env NUNCA vai para o GitHub.

PORT=3000
NODE_ENV=development

# SQLite local (caminho relativo à pasta prisma/).
# Em produção (Supabase/Neon): postgresql://usuario:senha@host:5432/banco?sslmode=require
DATABASE_URL="file:./dev.db"

# Gere um valor aleatório longo. Obrigatório quando NODE_ENV=production.
JWT_SECRET=troque-por-um-valor-aleatorio-longo
JWT_EXPIRACAO=8h

# Origens que podem chamar a API (separadas por vírgula). Live Server usa a porta 5500.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# A política do Nominatim exige identificar o app com um contato.
NOMINATIM_USER_AGENT="EcoEletroES/1.0 (seu-email@exemplo.com)"

TIMEOUT_EXTERNO_MS=5000
CEP_CACHE_DIAS=90

# Usuário administrador criado pelo seed (npm run db:seed).
ADMIN_EMAIL=admin@ecoeletro.local
ADMIN_SENHA=trocar123

# Quais pontos o seed carrega: reais (padrão), ficticios ou ambos.
SEED_DADOS=reais
