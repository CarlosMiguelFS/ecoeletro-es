{
  "name": "ecoeletro-es-api",
  "version": "1.0.0",
  "description": "API do EcoEletro ES — pontos de coleta de lixo eletrônico no Espírito Santo (Projeto PEI II)",
  "type": "module",
  "main": "src/servidor.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/servidor.js",
    "start": "node --env-file-if-exists=.env src/servidor.js",
    "db:push": "prisma db push",
    "db:seed": "node --env-file-if-exists=.env prisma/seed.js",
    "db:setup": "prisma db push && node --env-file-if-exists=.env prisma/seed.js",
    "db:studio": "prisma studio",
    "test": "node --env-file-if-exists=.env --env-file=.env.test --test",
    "postinstall": "prisma generate",
    "pretest": "node scripts/preparar-testes.js",
    "vercel-build": "node scripts/vercel-build.js"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "supertest": "^7.3.0"
  }
}
