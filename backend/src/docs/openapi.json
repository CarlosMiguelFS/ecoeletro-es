{
  "openapi": "3.0.3",
  "info": {
    "title": "EcoEletro ES — API",
    "version": "1.0.0",
    "description": "Pontos de coleta de lixo eletrônico no Espírito Santo (Projeto PEI II). Os dados do seed são fictícios."
  },
  "servers": [{ "url": "/api" }],
  "tags": [
    { "name": "Público" },
    { "name": "Autenticação" },
    { "name": "Admin", "description": "Exige token (botão Authorize)." }
  ],
  "paths": {
    "/pontos": {
      "get": {
        "tags": ["Público"],
        "summary": "Lista paginada de pontos ativos",
        "parameters": [
          { "name": "municipio", "in": "query", "schema": { "type": "string" }, "example": "Vila Velha" },
          {
            "name": "categoria",
            "in": "query",
            "schema": { "type": "string" },
            "example": "pilhas-baterias"
          },
          { "$ref": "#/components/parameters/tipo" },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20, "maximum": 200 } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ListaPontos" } } }
          },
          "400": { "$ref": "#/components/responses/Erro" }
        }
      }
    },
    "/pontos/proximos": {
      "get": {
        "tags": ["Público"],
        "summary": "Pontos mais próximos de um CEP ou de uma coordenada",
        "description": "Informe `cep` **ou** `lat` + `lng` (somente ES). Devolve todos os pontos dentro do raio (padrão 12 km). Se nenhum estiver no raio, devolve só o mais próximo, a qualquer distância, com `fora_do_raio: true`.",
        "parameters": [
          { "name": "cep", "in": "query", "schema": { "type": "string" }, "example": "29101-010" },
          { "name": "lat", "in": "query", "schema": { "type": "number" }, "example": -20.33 },
          { "name": "lng", "in": "query", "schema": { "type": "number" }, "example": -40.29 },
          {
            "name": "raio",
            "in": "query",
            "schema": { "type": "number", "default": 12, "maximum": 100 },
            "description": "km"
          },
          {
            "name": "limite",
            "in": "query",
            "schema": { "type": "integer", "default": 100, "maximum": 200 }
          },
          { "name": "categoria", "in": "query", "schema": { "type": "string" } },
          { "$ref": "#/components/parameters/tipo" }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Proximos" } } }
          },
          "400": { "$ref": "#/components/responses/Erro" },
          "404": { "$ref": "#/components/responses/Erro" },
          "422": { "$ref": "#/components/responses/Erro" },
          "503": { "$ref": "#/components/responses/Erro" }
        }
      }
    },
    "/pontos/{id}": {
      "get": {
        "tags": ["Público"],
        "summary": "Detalhe de um ponto",
        "parameters": [{ "$ref": "#/components/parameters/id" }],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Ponto" } } }
          },
          "404": { "$ref": "#/components/responses/Erro" }
        }
      }
    },
    "/categorias": {
      "get": {
        "tags": ["Público"],
        "summary": "Materiais aceitos",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/municipios": {
      "get": {
        "tags": ["Público"],
        "summary": "Municípios com pelo menos um ponto ativo",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/cep/{cep}": {
      "get": {
        "tags": ["Público"],
        "summary": "Endereço e coordenadas de um CEP do ES (com cache)",
        "parameters": [
          {
            "name": "cep",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "example": "29101010"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Cep" } } }
          },
          "400": { "$ref": "#/components/responses/Erro" },
          "404": { "$ref": "#/components/responses/Erro" },
          "422": { "$ref": "#/components/responses/Erro" },
          "503": { "$ref": "#/components/responses/Erro" }
        }
      }
    },
    "/sugestoes": {
      "post": {
        "tags": ["Público"],
        "summary": "Enviar sugestão, correção ou aviso de ponto fechado",
        "description": "Limite de 5 envios a cada 15 minutos por IP.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["tipo", "mensagem"],
                "properties": {
                  "tipo": { "type": "string", "enum": ["novo_ponto", "correcao", "ponto_fechado"] },
                  "ponto_id": {
                    "type": "integer",
                    "description": "Obrigatório para correcao e ponto_fechado"
                  },
                  "mensagem": { "type": "string", "minLength": 10, "maxLength": 1000 },
                  "email_contato": { "type": "string", "format": "email" },
                  "consentimento": {
                    "type": "boolean",
                    "description": "Obrigatório (true) se email_contato for enviado (LGPD)"
                  }
                }
              },
              "example": {
                "tipo": "ponto_fechado",
                "ponto_id": 3,
                "mensagem": "Passei lá hoje e o ponto está fechado."
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Criada" },
          "400": { "$ref": "#/components/responses/Erro" },
          "429": { "$ref": "#/components/responses/Erro" }
        }
      }
    },
    "/estatisticas": {
      "get": {
        "tags": ["Público"],
        "summary": "Totais por tipo, município e categoria",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Autenticação"],
        "summary": "Login do painel administrativo",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "senha"],
                "properties": { "email": { "type": "string" }, "senha": { "type": "string" } }
              },
              "example": { "email": "admin@ecoeletro.local", "senha": "trocar123" }
            }
          }
        },
        "responses": {
          "200": { "description": "Retorna { token, expira_em, usuario }" },
          "401": { "$ref": "#/components/responses/Erro" }
        }
      }
    },
    "/admin/pontos": {
      "get": {
        "tags": ["Admin"],
        "summary": "Lista todos os pontos, inclusive inativos",
        "security": [{ "bearer": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "OK" }, "401": { "$ref": "#/components/responses/Erro" } }
      },
      "post": {
        "tags": ["Admin"],
        "summary": "Cadastra um ponto",
        "description": "Sem latitude/longitude, o endereço é geocodificado automaticamente (Nominatim, depois CEP).",
        "security": [{ "bearer": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/Ponto" },
        "responses": {
          "201": { "description": "Criado" },
          "400": { "$ref": "#/components/responses/Erro" },
          "409": { "$ref": "#/components/responses/Erro" },
          "422": { "$ref": "#/components/responses/Erro" }
        }
      }
    },
    "/admin/pontos/{id}": {
      "get": {
        "tags": ["Admin"],
        "summary": "Detalhe (inclusive inativo)",
        "security": [{ "bearer": [] }],
        "parameters": [{ "$ref": "#/components/parameters/id" }],
        "responses": { "200": { "description": "OK" }, "404": { "$ref": "#/components/responses/Erro" } }
      },
      "put": {
        "tags": ["Admin"],
        "summary": "Substitui os dados de um ponto",
        "security": [{ "bearer": [] }],
        "parameters": [{ "$ref": "#/components/parameters/id" }],
        "requestBody": { "$ref": "#/components/requestBodies/Ponto" },
        "responses": { "200": { "description": "OK" }, "404": { "$ref": "#/components/responses/Erro" } }
      },
      "delete": {
        "tags": ["Admin"],
        "summary": "Desativa um ponto (somente papel admin)",
        "security": [{ "bearer": [] }],
        "parameters": [{ "$ref": "#/components/parameters/id" }],
        "responses": { "200": { "description": "OK" }, "403": { "$ref": "#/components/responses/Erro" } }
      }
    },
    "/admin/pontos/importar": {
      "post": {
        "tags": ["Admin"],
        "summary": "Importa pontos de um CSV (somente papel admin)",
        "description": "Separador `;` ou `,`. Colunas: nome, tipo, logradouro, numero, bairro, cep, municipio, latitude, longitude, telefone, email, site, horario (JSON), observacoes, categorias (separadas por `|`). Máximo de 200 linhas. Veja backend/seed/exemplo-importacao.csv.",
        "security": [{ "bearer": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": { "arquivo": { "type": "string", "format": "binary" } }
              }
            }
          }
        },
        "responses": { "200": { "description": "Retorna { total_linhas, criados, atualizados, erros[] }" } }
      }
    },
    "/admin/sugestoes": {
      "get": {
        "tags": ["Admin"],
        "summary": "Lista sugestões",
        "security": [{ "bearer": [] }],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": { "type": "string", "enum": ["pendente", "aprovada", "rejeitada"] }
          }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/admin/sugestoes/{id}": {
      "patch": {
        "tags": ["Admin"],
        "summary": "Aprova ou rejeita uma sugestão",
        "security": [{ "bearer": [] }],
        "parameters": [{ "$ref": "#/components/parameters/id" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "status": { "type": "string", "enum": ["aprovada", "rejeitada"] } }
              }
            }
          }
        },
        "responses": { "200": { "description": "OK" }, "404": { "$ref": "#/components/responses/Erro" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "parameters": {
      "id": { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
      "tipo": {
        "name": "tipo",
        "in": "query",
        "schema": { "type": "string", "enum": ["ecoponto", "loja_parceira", "cooperativa", "orgao_publico"] }
      }
    },
    "requestBodies": {
      "Ponto": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["nome", "tipo", "logradouro", "bairro", "cep", "municipio", "categorias"],
              "properties": {
                "nome": { "type": "string" },
                "tipo": {
                  "type": "string",
                  "enum": ["ecoponto", "loja_parceira", "cooperativa", "orgao_publico"]
                },
                "logradouro": { "type": "string" },
                "numero": { "type": "string" },
                "bairro": { "type": "string" },
                "cep": { "type": "string" },
                "municipio": { "type": "string" },
                "latitude": { "type": "number" },
                "longitude": { "type": "number" },
                "telefone": { "type": "string" },
                "email": { "type": "string" },
                "site": { "type": "string" },
                "horario": { "type": "object", "additionalProperties": { "type": "string" } },
                "observacoes": { "type": "string" },
                "categorias": { "type": "array", "items": { "type": "string" } },
                "ativo": { "type": "boolean" },
                "verificado_em": { "type": "string", "format": "date" }
              }
            },
            "example": {
              "nome": "Ecoponto Exemplo",
              "tipo": "ecoponto",
              "logradouro": "Av. Nossa Senhora da Penha",
              "numero": "100",
              "bairro": "Praia do Canto",
              "cep": "29055-131",
              "municipio": "Vitória",
              "horario": { "seg-sex": "08:00-17:00" },
              "categorias": ["pilhas-baterias", "celulares-tablets"]
            }
          }
        }
      }
    },
    "responses": {
      "Erro": {
        "description": "Erro",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Erro" } } }
      }
    },
    "schemas": {
      "Erro": {
        "type": "object",
        "properties": {
          "erro": {
            "type": "object",
            "properties": {
              "codigo": { "type": "string", "example": "CEP_FORA_DO_ES" },
              "mensagem": { "type": "string", "example": "Este CEP não pertence ao Espírito Santo." },
              "detalhes": { "type": "array", "items": { "type": "object" } }
            }
          }
        }
      },
      "Ponto": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "nome": { "type": "string" },
          "tipo": { "type": "string" },
          "distancia_km": { "type": "number", "description": "Só em /pontos/proximos" },
          "endereco": { "type": "string" },
          "cep": { "type": "string" },
          "municipio": { "type": "string" },
          "latitude": { "type": "number" },
          "longitude": { "type": "number" },
          "telefone": { "type": "string", "nullable": true },
          "horario": { "type": "object", "nullable": true },
          "categorias": { "type": "array", "items": { "type": "string" } },
          "como_chegar": { "type": "string" }
        }
      },
      "ListaPontos": {
        "type": "object",
        "properties": {
          "total": { "type": "integer" },
          "page": { "type": "integer" },
          "limit": { "type": "integer" },
          "paginas": { "type": "integer" },
          "pontos": { "type": "array", "items": { "$ref": "#/components/schemas/Ponto" } }
        }
      },
      "Cep": {
        "type": "object",
        "properties": {
          "cep": { "type": "string" },
          "logradouro": { "type": "string", "nullable": true },
          "bairro": { "type": "string", "nullable": true },
          "cidade": { "type": "string" },
          "uf": { "type": "string" },
          "latitude": { "type": "number" },
          "longitude": { "type": "number" },
          "fonte": {
            "type": "string",
            "enum": ["nominatim", "nominatim_bairro", "brasilapi", "centro_municipio", "nominatim_cidade"]
          },
          "precisao": { "type": "string", "enum": ["endereco", "bairro", "municipio"] }
        }
      },
      "Proximos": {
        "type": "object",
        "properties": {
          "origem": { "type": "object" },
          "raio_km": { "type": "number" },
          "fora_do_raio": { "type": "boolean" },
          "total": { "type": "integer" },
          "pontos": { "type": "array", "items": { "$ref": "#/components/schemas/Ponto" } }
        }
      }
    }
  }
}
